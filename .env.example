# TC Pilot 환경변수
# 이 파일을 복사하여 .env.local 로 저장하고 값을 채워주세요.
# .env.local 은 git에 커밋하지 마세요.
# 자세한 발급 방법: docs/API_KEYS_GUIDE.md 참고

# Claude API (Anthropic) - 스펙 변환, TC 생성, 이슈 보강
ANTHROPIC_API_KEY=

# Supabase (DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Notion (이슈 등록)
NOTION_API_KEY=
NOTION_ISSUE_DATABASE_ID=
